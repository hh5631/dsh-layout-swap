{
  "name": "dsh-layout-swap",
  "version": "1.0.1",
  "description": "DSH 布局交换：文件和浏览器居中，聊天放到右侧，可拖动并记住布局。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "node --check lib/index.js && node --check lib/client.js && node --check lib/release-check.mjs" },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "peerDependencies": { "react": "^18.2.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hh5631/dsh-layout-swap.git"
  },
  "homepage": "https://github.com/hh5631/dsh-layout-swap#readme"
}
